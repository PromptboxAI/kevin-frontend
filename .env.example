# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Source: kevin-backend/FRONTEND.md section 7.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# PUBLISHABLE / anon key only. Never the service-role key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Backend base URL. Local: http://localhost:8000
# Production: https://<your-railway-app>.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile site key for the home-page photo demo.
# Pairs with TURNSTILE_SECRET on the API: without the secret set there,
# POST /v1/demo/drops answers 503. Unset here, the demo shows its sample
# photos and says live drops are off.
VITE_TURNSTILE_SITE_KEY=<turnstile-site-key>

