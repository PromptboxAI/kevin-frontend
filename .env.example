# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Source: kevin-backend/FRONTEND.md section 7.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# PUBLISHABLE / anon key only. Never the service-role key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Backend base URL. Local: http://localhost:8000
# Production: https://<your-railway-app>.up.railway.app
VITE_API_BASE_URL=http://localhost:8000
